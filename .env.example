# Кабинет: Docker Compose автоматически читает корневой .env
API_PORT=8000
CHAT_MODE=demo
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# model — свободный диалог. Укажите OpenAI-совместимый API открытой модели.
LLM_API_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=
LLM_API_KEY=
# Необязательно: другой адрес только для контейнера (Ollama на компьютере).
LLM_DOCKER_API_BASE_URL=
LLM_RESPONSE_FORMAT=json_schema
HTTP_TIMEOUT_SECONDS=120
LLM_CONTEXT_SIZE=16384
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_REASONING_EFFORT=
AGENT_TOOLS_ENABLED=true
AGENT_MAX_TOOL_CALLS=3
CHAT_MAX_CONCURRENT_GENERATIONS=2
# Публичный поиск необязателен; без ключа кредитный путь работает полностью.
TAVILY_API_KEY=

# Стенд: применяются только с compose.stand.yaml
# Для публичного стенда: STAND_BIND_ADDRESS=0.0.0.0
STAND_BIND_ADDRESS=127.0.0.1
STAND_SITE=http://localhost
STAND_HTTP_PORT=80
STAND_HTTPS_PORT=443
