# Приложение
APP_NAME=delo-za-malyn
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api/v1
APP_API_KEY=
DEBUG=false
LOG_LEVEL=INFO

# Кабинет FastAPI / Docker Compose (тот же файл передаётся через --env-file)
CHAT_MODE=model
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Из контейнера Ollama на компьютере доступна по отдельному адресу
LLM_DOCKER_API_BASE_URL=http://host.docker.internal:11434/v1

# Локальный API модели: сейчас Ollama, позже можно llama.cpp
LLM_API_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=hf.co/yuxinlu1/gemma-4-12B-agentic-fable5-composer2.5-v2-3.5x-tau2-GGUF:Q4_K_M
HTTP_TIMEOUT_SECONDS=120

# Загрузка модели и генерация
LLAMA_SERVER_BIN=/opt/homebrew/bin/llama-server
LLM_MODEL_PATH=Models/Llm/weights/gemma4-v2-Q4_K_M.gguf
LLM_CONTEXT_SIZE=8192
LLM_GPU_LAYERS=0
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_TOP_K=64
LLM_REPEAT_PENALTY=1.1

# Пусто = режим рассуждений по умолчанию у выбранной модели/сервера
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REASONING_EFFORT=

# Агент: путь от scr/delo_za_malyn. Промпты заполняются отдельно.
AGENT_PROMPTS_DIR=Models/Agent/prompts
AGENT_MAX_TOOL_CALLS=3
# true — инструменты веб-чата; отдельный лабораторный API по-прежнему без инструментов
AGENT_TOOLS_ENABLED=true

# Тестовый API: пределы истории запроса, не размер контекста модели в токенах
CHAT_MAX_MESSAGES=20
CHAT_MAX_INPUT_CHARS=12000

# Tavily: ключ только в локальном .env; поиск basic, без автоповышения глубины.
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=20
TAVILY_MAX_RESULTS=3
TAVILY_SNIPPET_CHARS=1000
