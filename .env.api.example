# Copy to .env.api and set the key; Docker sends it only to the backend.
LLM_API_BASE_URL=https://inference.dahl.global/v1
LLM_MODEL=MiniMaxAI/MiniMax-M2.7
LLM_API_KEY=
LLM_RESPONSE_FORMAT=json_object
HTTP_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_CONTEXT_SIZE=16384
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REASONING_EFFORT=
CHAT_MAX_CONCURRENT_GENERATIONS=2
AGENT_TOOLS_ENABLED=true
DEMO_BUSINESS_SCALE=6
DEMO_PORT=18007
