# Приложение
APP_NAME=delo-za-malyn
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api/v1
APP_API_KEY=
DEBUG=false
LOG_LEVEL=INFO

# Локальный API модели: сейчас Ollama, позже можно llama.cpp
LLM_API_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=
HTTP_TIMEOUT_SECONDS=120

# Загрузка модели и генерация
LLAMA_SERVER_BIN=/opt/homebrew/bin/llama-server
LLM_MODEL_PATH=
LLM_CONTEXT_SIZE=8192
LLM_GPU_LAYERS=99
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_TOP_K=64
LLM_REPEAT_PENALTY=1.1

# Пусто = режим рассуждений по умолчанию у выбранной модели/сервера
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REASONING_EFFORT=
